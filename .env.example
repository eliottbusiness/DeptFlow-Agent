# Variables d'environnement — DeptFlow-Agent
# Copiez ce fichier en .env et remplissez les valeurs
# Ne jamais committer le fichier .env dans Git

# === API BEREACH ===
# Votre clé API Bereach (https://bereach.co)
BEREACH_API_KEY=

# === TELEGRAM ===
# Token de votre bot Telegram (obtenu via @BotFather)
TELEGRAM_BOT_TOKEN=
# ID du chat Telegram où envoyer les alertes
TELEGRAM_CHAT_ID=

# === LLM (OpenRouter) ===
# Votre clé API OpenRouter (https://openrouter.ai)
LLM_API_KEY=
# Modèle LLM à utiliser (ex: anthropic/claude-sonnet-4-5)
LLM_MODEL=anthropic/claude-sonnet-4-5
